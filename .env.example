# Copy to .env. Everything is optional except where a source needs credentials.
DATABASE_URL=postgresql+psycopg://ipalpha:ipalpha@localhost:5433/ipalpha

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ip-alpha/0.1 by u/your_username

# MyAnimeList official API (optional; Jikan is used when unset).
# Create a client at https://myanimelist.net/apiconfig
MAL_CLIENT_ID=

# Bluesky: Settings > Privacy and security > App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Language model: any OpenAI-compatible server. Defaults to a local Ollama with
#   ollama pull qwen2.5:7b && ollama pull bge-m3
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# Dashboard -> API (used by the Next.js server)
API_URL=http://localhost:8000

# Redis: rate limiters, HTTP cache, and the job queue. Compose overrides this for its services.
REDIS_URL=redis://localhost:6380/0
# Shared secret for admin endpoints (X-Admin-Token header). Unset disables them (503).
# ADMIN_TOKEN=change-me

# Ingestion: per-source (requests per second, burst) as JSON; unset keeps the defaults.
# RATE_LIMITS={"steam": [1.0, 1], "steamspy": [1.0, 1], "jikan": [1.0, 3], "mal_api": [2.0, 2], "bluesky": [2.0, 2], "oricon": [0.2, 1]}
HTTP_CACHE_ENABLED=true
HTTP_MAX_RETRIES=4

# Worker: maximum run time of one job, in seconds
JOB_TIMEOUT_S=3600

# LLM retries on transient errors, and the hypothetical API price (USD per million tokens)
# used to put a cost on local model calls.
LLM_MAX_RETRIES=3
LLM_PRICE_IN_PER_MTOK=0.15
LLM_PRICE_OUT_PER_MTOK=0.60

# Logging. LOG_JSON=true emits one JSON object per line.
LOG_JSON=false
LOG_LEVEL=INFO
# Langfuse tracing (optional; all three are needed to enable it)
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Set to false on deployments without an LLM; POST /chat then returns 503.
CHAT_ENABLED=true
