# Copy to .env.prod next to docker-compose.prod.yml on the server and fill in.
# The real .env.prod holds secrets: never commit it.

# Public hostname for the API. Point its DNS A record at the Lightsail static IP;
# Caddy obtains the TLS certificate automatically.
API_DOMAIN=api.example.com

# Image published by CI: ghcr.io/<GHCR_OWNER>/ip-alpha-api:<IMAGE_TAG>
GHCR_OWNER=bryl-dev
IMAGE_TAG=latest
# Only needed if the GHCR package is private: a token with read:packages scope.
# GHCR_USER=
# GHCR_TOKEN=

# Postgres (internal to the compose network)
POSTGRES_USER=ipalpha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ipalpha

# Shared secret for admin endpoints (X-Admin-Token header)
ADMIN_TOKEN=change-me-to-a-long-random-string

# The hosted demo runs without chat; POST /chat returns 503.
CHAT_ENABLED=false

# The Vercel frontend's origin
CORS_ORIGINS=["https://<vercel-app>.vercel.app"]

# Hosted OpenAI-compatible LLM server (no local GPU on Lightsail). The embedding model
# must return 1024-dimensional vectors to match the documents.embedding column.
LLM_BASE_URL=https://<openai-compatible-host>/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# Social sources (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ip-alpha/0.1 by u/your_username
MAL_CLIENT_ID=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

LOG_LEVEL=INFO
